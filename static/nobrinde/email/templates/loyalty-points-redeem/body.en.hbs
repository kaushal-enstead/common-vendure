<mjml>
    <mj-body>
        {{> header title="You've Redeemed Loyalty Points!"  }}

        <mj-section>
            <mj-column>
                <mj-text>
                    Hello {{ customerName }},<br />
                    You've just redeemed <strong>{{ points }}</strong> loyalty points on your recent order
                    (ID: {{ orderId }}).
                </mj-text>

                <mj-text font-size="18px" font-weight="bold" color="#0d6efd">
                    Remaining Points Balance: <strong>{{ balance }}</strong>
                </mj-text>

                <mj-text>
                    Thank you for using your loyalty points! We appreciate your continued support and hope you
                    enjoy your rewards.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column>
                <mj-text>
                    Please do not reply to this email as it is an automatic reply and will not be read*<br />
                    We remind you of our service channels:<br />
                    Support: geral@setubalconnect.pt
                </mj-text>
            </mj-column>
        </mj-section>

        {{> footer }}
    </mj-body>
</mjml>
