<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Forgotten password reset" }}

    <mj-section>
      <mj-column>
        <mj-text> Someone requested a new password for your account. </mj-text>

        <mj-button
          href="{{ passwordResetUrl }}?token={{ passwordResetToken }}"
          background-color="#f45e43"
          color="white"
          border-radius="5px"
        >
          Reset password
        </mj-button>

        <mj-text>
          If you didn't make this request you can safely ignore this email — nothing has been changed on your
          account.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
