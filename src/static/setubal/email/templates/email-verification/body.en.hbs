<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Verify Your Email Address" }}

    <mj-section>
      <mj-column>
        <mj-text>
          Dear {{ order.customer.firstName }} {{ order.customer.lastName }},<br />
          Thank you for your registration on Setúbal Connect marketplace.
        </mj-text>

        <mj-text>
          Click the button below to verify this email address and complete the registration process.
          <br />
          If you didn't make this request then you can safely ignore this email - nothing has been changed on
          your account.
        </mj-text>

        <mj-button
          href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}"
          background-color="#375a67"
          color="white"
          font-size="16px"
          font-weight="bold"
          border-radius="4px"
          padding="12px 24px"
        >
          Verify Email Address
        </mj-button>

        <mj-text font-size="14px" color="#666666"> This verification link will expire in 24 hours. </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
