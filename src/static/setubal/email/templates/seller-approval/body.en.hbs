<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Seller Approval" }}

    <mj-section>
      <mj-column>
        <mj-text>
          Your registration was approved. Follow the link and insert your credentials to access your admin
          panel. If you didn't make this request then you can safely ignore this email - nothing has been
          changed on your account.
        </mj-text>

        <mj-button
          href="{{ adminLoginUrl }}"
          background-color="#375a67"
          color="white"
          font-size="16px"
          font-weight="bold"
          border-radius="4px"
          padding="12px 24px"
        >
          Login
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
