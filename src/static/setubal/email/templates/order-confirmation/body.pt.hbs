<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Recibo de Encomenda" }}

    <mj-section>
      <mj-column>
        <mj-text>
          Caro {{ order.customer.firstName }} {{ order.customer.lastName }},<br />
          Obrigado pela tua encomenda!<br />
          Abaixo encontra os detalhes da sua encomenda que também podem ser consultados na sua área pessoal no
          Setúbal Connect Marketplace no separador Encomendas.
        </mj-text>

        <mj-text>
          <strong>Código:</strong> {{ order.code }}<br />
          <strong>Data:</strong> {{ formatDate order.orderPlacedAt }}<br />
          <strong>Total:</strong> {{ formatMoney order.total order.currencyCode 'en' }}
        </mj-text>
      </mj-column>
    </mj-section>

    {{#with order.shippingAddress }}
    <mj-section>
      <mj-column>
        <mj-text>
          <h3>Enviado Para: {{ fullName }}</h3>
          <ul style="list-style-type: none; padding: 0">
            {{#if company}}
            <li>{{ company }}</li>
            {{/if}}
            {{#if streetLine1}}
            <li>{{ streetLine1 }}</li>
            {{/if}}
            {{#if streetLine2}}
            <li>{{ streetLine2 }}</li>
            {{/if}}
            {{#if city}}
            <li>{{ city }}</li>
            {{/if}}
            {{#if province}}
            <li>{{ province }}</li>
            {{/if}}
            {{#if postalCode}}
            <li>{{ postalCode }}</li>
            {{/if}}
            {{#if country}}
            <li>{{ country }}</li>
            {{/if}}
            {{#if phoneNumber}}
            <li>{{ phoneNumber }}</li>
            {{/if}}
          </ul>
        </mj-text>
      </mj-column>
    </mj-section>
    {{/with}}

    <mj-section>
      <mj-column>
        <mj-text>
          <h3>Resumo da Encomenda</h3>
        </mj-text>

        <mj-table>
          {{#each order.lines }}
          <tr>
            <td>
              <img src="{{ featuredAsset.preview }}?w=50&h=50" alt="" width="50" height="50" />
            </td>
            <td>{{ quantity }} x {{ productVariant.name }}</td>
            <td>{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}</td>
          </tr>
          {{/each}}

          {{#each order.discounts }}
          <tr>
            <td colspan="2">{{ description }}</td>
            <td>{{ formatMoney amount ../order.currencyCode 'en' }}</td>
          </tr>
          {{/each}}

          <tr>
            <td colspan="2"><strong>Subtotal</strong></td>
            <td>{{ formatMoney order.subTotalWithTax order.currencyCode 'en' }}</td>
          </tr>

          {{#each shippingLines }}
          <tr>
            <td colspan="2">Envio ({{ shippingMethod.name }}):</td>
            <td>{{ formatMoney priceWithTax ../order.currencyCode 'en' }}</td>
          </tr>
          {{/each}}

          <tr>
            <td colspan="2"><strong>Total</strong></td>
            <td>{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Por favor, não responda a este e-mail, pois é uma resposta automática e não será lida*<br />
          Lembramos os nossos canais de atendimento:<br />
          Suporte: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
