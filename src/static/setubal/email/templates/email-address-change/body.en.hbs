<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Verify Your New Email Address" }}

    <mj-section>
      <mj-column>
        <mj-text>
          We received a request to change your registered email address to this one. Click the button below to
          verify this address and complete the process:
        </mj-text>

        <mj-text>
          If you didn't make this request then you can safely ignore this email - nothing has been changed on
          your account.
        </mj-text>

        <mj-button
          href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}"
          background-color="#f45e43"
          color="white"
          font-size="16px"
          border-radius="5px"
          padding="12px 20px"
        >
          Verify Me!
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
