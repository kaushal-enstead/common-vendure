<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Courier Registration Rejected" }}

    <mj-section>
      <mj-column>
        <mj-text font-size="16px">
          Dear {{ name }},
          <br />
          Unfortunately, your courier registration was not approved.
        </mj-text>

        <mj-text font-size="16px">
          Reason:<br />
          <strong>{{ reason }}</strong>
        </mj-text>

        <mj-text font-size="14px"> If you have any questions, please contact our support. </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
