<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Delivery Validation Code" }}

    <mj-section>
      <mj-column>
        <mj-text font-size="16px" color="#333">
          Dear {{ name }},
          <br />
          Your order requires a delivery validation code.
        </mj-text>

        <mj-text font-size="18px" font-weight="bold" align="center" color="#0d6efd">
          {{ code }}
        </mj-text>

        <mj-text font-size="14px" color="#555">
          Please pass this code on to your courier so that the delivery can be confirmed.
        </mj-text>

        <mj-text font-size="14px" color="#777">
          If you have any questions, please contact our support.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
