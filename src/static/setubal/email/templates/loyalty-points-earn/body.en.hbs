<mjml>
  <mj-body>
    {{> header title="You've Earned Loyalty Points!"  }}

    <mj-section>
      <mj-column>
        <mj-text>
          Hello {{ customerName }},<br />
          Congratulations! You have earned <strong>{{ points }}</strong> new loyalty points for your recent
          order (ID: {{ orderId }}).
        </mj-text>

        <mj-text font-size="18px" font-weight="bold" color="#0d6efd">
          Current Points Balance: <strong>{{ balance }}</strong>
        </mj-text>

        <mj-text>
          You can use these points on your next purchase for exclusive discounts. Thank you for being a loyal
          customer!
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read*<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
