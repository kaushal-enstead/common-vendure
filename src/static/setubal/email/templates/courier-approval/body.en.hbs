<mjml>
  <mj-body>
    {{> header }}
    {{> title title="Courier Registration Approved" }}

    <mj-section>
      <mj-column>
        <mj-text font-size="16px">
          Dear {{ name }},
          <br />
          We are pleased to inform you that your courier registration has been <strong>approved</strong>.
        </mj-text>

        <mj-text font-size="14px">
          You can now access your courier account and start accepting deliveries through our platform.
        </mj-text>

        <mj-text font-size="14px"> If you have any questions, please contact our support team. </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          Please do not reply to this email as it is an automatic reply and will not be read.<br />
          We remind you of our service channels:<br />
          Support: geral@setubalconnect.pt
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer }}
  </mj-body>
</mjml>
