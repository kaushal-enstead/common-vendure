{
  "name": "evora-vendure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "dev:dashboard": "vite --clearScreen false",
    "dev": "concurrently --kill-others npm:dev:*",
    "build:server": "rimraf dist && tsc",
    "build": "npm run build:server && npm run build:dashboard",
    "build:dashboard": "vite build",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "concurrently npm:start:*",
    "db:migrate": "npx vendure migrate"
  },
  "dependencies": {
    "@vendure/asset-server-plugin": "3.6.3",
    "@vendure/core": "3.6.3",
    "@vendure/dashboard": "3.6.3",
    "@vendure/email-plugin": "3.6.3",
    "@vendure/graphiql-plugin": "3.6.3",
    "dotenv": "17.4.2",
    "mysql2": "3.22.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@vendure/cli": "3.6.3",
    "concurrently": "9.2.1",
    "rimraf": "^6.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
